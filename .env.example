# ExtraWork environment template.
#
# Copy to `.env` for local development:  cp .env.example .env
#
# This file contains NO secrets and must never contain any. Report §11.3:
# "Secrets live in the deployment provider's encrypted secret manager, not
# repository or .env files committed to source." The values below are
# development placeholders; `packages/config` refuses to boot with them when
# APP_ENV=production.
#
# Generate real secrets with:  openssl rand -base64 48

NODE_ENV=development
APP_ENV=local

# --- Network -----------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# --- Database ----------------------------------------------------------------
# Matches the docker-compose service. Change the host to `localhost` when
# running Postgres outside Docker.
# Matches the credentials in docker-compose.yml. If you run PostgreSQL some
# other way, point this at it — nothing else in the stack assumes a port.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/extrawork
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=3
# Keep remote TLS connections warm; pg's 10-second default causes multi-second reconnects.
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_SSL=false
# Separate role used only by documented repair commands (report §9.6).
# DATABASE_MAINTENANCE_URL=postgres://extrawork_maintenance:...@localhost:5432/extrawork

# --- Secrets (development placeholders — replace before any shared deploy) ---
SESSION_SECRET=dev-session-secret-not-for-production-use
PRIVACY_HASH_SECRET=dev-privacy-secret-not-for-production-use
STORAGE_URL_SECRET=dev-storage-secret-not-for-production-use
SESSION_TTL_HOURS=12
PUBLIC_SESSION_TTL_MINUTES=60

# --- Authentication ----------------------------------------------------------
# `local`    first-party email magic link, for development and self-hosting
# `supabase` / `clerk`  managed provider; set the JWKS values below
AUTH_DRIVER=local
MAGIC_LINK_TTL_MINUTES=15
# AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# AUTH_JWT_AUDIENCE=authenticated
# AUTH_WEBHOOK_SECRET=

# --- Object storage ----------------------------------------------------------
# `local` writes to STORAGE_LOCAL_ROOT and signs URLs with STORAGE_URL_SECRET.
# It is rejected in production; use S3/MinIO/R2 there.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_BUCKET=extrawork-local
STORAGE_REGION=ap-south-1
STORAGE_FORCE_PATH_STYLE=true
# For MinIO in docker-compose:
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=extrawork
# STORAGE_SECRET_ACCESS_KEY=extrawork-dev-secret
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=15728640
MAX_ATTACHMENTS_PER_VERSION=12

# --- Messaging ---------------------------------------------------------------
# `simulator`    records outbound messages to WHATSAPP_SIMULATOR_DIR and exposes
#                /webhooks/v1/simulator/* so the whole intake flow runs with no
#                Meta account. Development default; refused in production.
# `native-share` the contractor sends the link from their own WhatsApp.
# `cloud-api`    the real Meta Cloud API (report §10.3 Phase 1).
WHATSAPP_DRIVER=simulator
WHATSAPP_SIMULATOR_DIR=./.data/whatsapp
# All four are required together when WHATSAPP_DRIVER=cloud-api; the process
# refuses to start rather than falling back to native share.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Meta retires Graph API versions on a schedule. Check Meta's changelog and set
# this to a currently supported version before deploying.
# WHATSAPP_GRAPH_API_VERSION=v21.0

# `console` logs the message; `file` writes .eml files to EMAIL_OUTBOX_DIR;
# `smtp` actually sends. Both console and file are refused in production.
#
# Neither console nor file transmits anything, which is the right default for
# development but means confirmation and sign-in links never leave the machine.
# Reach for `smtp` the moment you need a link to arrive somewhere.
EMAIL_DRIVER=file
EMAIL_FROM=ExtraWork <no-reply@extrawork.local>
EMAIL_OUTBOX_DIR=./.data/mail

# Any standard SMTP URL; it is handed straight to nodemailer.
#
# Mailpit, from docker-compose — a real SMTP round trip with no account and no
# credentials, readable at http://localhost:8025:
# EMAIL_DRIVER=smtp
# SMTP_URL=smtp://localhost:1025
#
# Resend — username is literally `resend`, password is the API key:
# EMAIL_DRIVER=smtp
# SMTP_URL=smtps://resend:re_your_api_key@smtp.resend.com:465
#
# Until a domain is verified, Resend only accepts `onboarding@resend.dev` as the
# sender and only delivers to the address the account was registered with. That
# is enough to test a signup end to end; anything else needs a domain you own
# with SPF and DKIM published, which Gmail and Yahoo now require outright.
# EMAIL_FROM=ExtraWork <onboarding@resend.dev>

# `console`  logs nothing deliverable — development only, refused in production.
# `whatsapp` sends the code through the WhatsApp gateway. The approver's number
#            is already on record, so A1 needs no second provider. Requires
#            WHATSAPP_DRIVER=cloud-api and an approved AUTHENTICATION-category
#            template named extra_work_otp_v1 (not Utility — Meta rejects that).
OTP_DRIVER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

PAYMENTS_DRIVER=disabled
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

ESIGN_DRIVER=disabled

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300
WORKER_SCHEDULER_ENABLED=true
PDF_TIMEOUT_MS=120000

# --- Policy ------------------------------------------------------------------
APPROVAL_TOKEN_MAX_LIFETIME_DAYS=30
DEFAULT_REQUEST_EXPIRY_DAYS=7
REMINDER_LOCAL_HOUR_START=9
REMINDER_LOCAL_HOUR_END=20

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
SERVICE_NAME=extrawork
RATE_LIMIT_ENABLED=true

# --- Web app (Next.js) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
