{"nodes": [{"id": "docs_handoff_md", "label": "HANDOFF.md", "file_type": "document", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_extrawork_product", "label": "ExtraWork Product", "file_type": "concept", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_whatsapp_product_pivot", "label": "WhatsApp Product Pivot", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Founder redefined the product so the employee's entire interface is one WhatsApp message; overrides report \u00a710.3 (native-share only) and \u00a715.2 (e-sign deferred)."}, {"id": "docs_handoff_md_whatsapp_intake_flow", "label": "Target WhatsApp Intake Flow", "file_type": "concept", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_owner_dashboard", "label": "Owner Dashboard", "file_type": "concept", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_invariant_money_never_float", "label": "Money Never a Float", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer minor units end to end; one engine computes every total so a client preview can never become authoritative."}, {"id": "docs_handoff_md_invariant_frozen_sent_version", "label": "Sent Version Is Frozen", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Send freezes an RFC 8785 canonical JSON snapshot + SHA-256 digest; later edits create a new version and revoke the old token instead of mutating history."}, {"id": "docs_handoff_md_invariant_atomic_decisions", "label": "Decisions Atomic and Idempotent", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision + audit + projection + outbox commit in one transaction; a unique constraint allows at most one decision per version so races resolve to one winner."}, {"id": "docs_handoff_md_invariant_no_provider_in_tx", "label": "No Provider Call Inside a Transaction", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Side effects route through a transactional outbox and a Postgres job queue (FOR UPDATE SKIP LOCKED) so provider latency never holds a DB lock."}, {"id": "docs_handoff_md_invariant_evidence_append_only", "label": "Evidence Is Append-Only", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced by DB triggers and revoked role privileges; corrections only via an audited repair command that records before/after digests."}, {"id": "docs_handoff_md_invariant_tenant_scoping", "label": "Tenant Scoping Mandatory", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cross-tenant reference returns NOT_FOUND rather than FORBIDDEN so an attacker cannot confirm an ID exists elsewhere."}, {"id": "docs_handoff_md_migration_0005_whatsapp_intake", "label": "Migration 0005 WhatsApp Intake", "file_type": "code", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_whatsapp_gateway", "label": "WhatsApp Gateway Interface", "file_type": "concept", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_simulator_gateway", "label": "Simulator WhatsApp Gateway", "file_type": "code", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_whatsapp_cloud_gateway", "label": "WhatsApp Cloud Gateway", "file_type": "code", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_whatsapp_template_window_rule", "label": "24-Hour Template Window Rule", "file_type": "rationale", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WhatsApp only permits free-form replies within 24h of the person messaging first; outbound-first messages to the customer must use a pre-approved UTILITY template with a dynamic URL button."}, {"id": "docs_handoff_md_intake_parser", "label": "Intake Message Parser", "file_type": "code", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_intake_match", "label": "Fuzzy Project Match", "file_type": "code", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handoff_md_intake_service", "label": "Intake Service", "file_type": "concept", "source_file": "docs/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs