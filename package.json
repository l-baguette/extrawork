{
  "name": "extrawork",
  "private": true,
  "version": "1.0.0",
  "description": "WhatsApp-first contract-change and approval ledger for Indian project businesses",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter @extrawork/api build && pnpm --filter @extrawork/worker build && pnpm --filter @extrawork/web build",
    "build:packages": "pnpm -r --filter=./packages/** build",
    "build:server": "pnpm build:packages && pnpm --filter @extrawork/api build && pnpm --filter @extrawork/worker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @extrawork/db migrate",
    "db:reset": "pnpm --filter @extrawork/db reset",
    "db:seed": "pnpm --filter @extrawork/testkit seed",
    "db:harden": "pnpm --filter @extrawork/db harden",
    "openapi": "pnpm --filter @extrawork/api openapi",
    "dev": "pnpm --filter @extrawork/api dev & pnpm --filter @extrawork/worker dev & pnpm --filter @extrawork/web dev",
    "dev:api": "pnpm --filter @extrawork/api dev",
    "dev:worker": "pnpm --filter @extrawork/worker dev",
    "dev:web": "pnpm --filter @extrawork/web dev",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:golden": "vitest run --project golden",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:all",
    "db:verify-chain": "pnpm --filter @extrawork/db verify-chain",
    "db:repair": "pnpm --filter @extrawork/db repair-project-totals",
    "db:replay": "pnpm --filter @extrawork/db replay",
    "e2e": "playwright test",
    "dev:lan": "bash scripts/dev-lan.sh",
    "preflight:hosted": "tsx scripts/preflight-hosted.mts",
    "db:test-account": "tsx scripts/seed-test-account.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@extrawork/api": "workspace:*",
    "@extrawork/application": "workspace:*",
    "@extrawork/config": "workspace:*",
    "@extrawork/contracts": "workspace:*",
    "@extrawork/db": "workspace:*",
    "@extrawork/domain": "workspace:*",
    "@extrawork/files": "workspace:*",
    "@extrawork/integrations": "workspace:*",
    "@extrawork/observability": "workspace:*",
    "@extrawork/runtime": "workspace:*",
    "@extrawork/testkit": "workspace:*",
    "@next/eslint-plugin-next": "15.1.4",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "drizzle-orm": "0.38.3",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "fast-check": "3.23.2",
    "pdfjs-dist": "4.9.155",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "2.1.8"
  }
}
