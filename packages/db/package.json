{
  "name": "@extrawork/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --conditions=development --import tsx src/cli/migrate.ts",
    "reset": "node --conditions=development --import tsx src/cli/reset.ts",
    "harden": "node --conditions=development --import tsx src/cli/harden.ts",
    "verify-chain": "node --conditions=development --import tsx src/cli/verify-chain.ts",
    "repair-project-totals": "node --conditions=development --import tsx src/cli/repair-project-totals.ts",
    "replay": "node --conditions=development --import tsx src/cli/replay.ts"
  },
  "dependencies": {
    "@extrawork/config": "workspace:*",
    "@extrawork/contracts": "workspace:*",
    "@extrawork/domain": "workspace:*",
    "@extrawork/observability": "workspace:*",
    "drizzle-orm": "0.38.3",
    "pg": "8.13.1",
    "uuidv7": "1.0.2"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1"
  }
}
