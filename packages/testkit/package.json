{
  "name": "@extrawork/testkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "development": "./src/seed/seed.ts",
      "types": "./dist/seed/seed.d.ts",
      "default": "./dist/seed/seed.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --conditions=development --import tsx src/seed/cli.ts"
  },
  "dependencies": {
    "@extrawork/application": "workspace:*",
    "@extrawork/config": "workspace:*",
    "@extrawork/contracts": "workspace:*",
    "@extrawork/db": "workspace:*",
    "@extrawork/domain": "workspace:*",
    "@extrawork/files": "workspace:*",
    "@extrawork/integrations": "workspace:*",
    "@extrawork/observability": "workspace:*",
    "@extrawork/runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
